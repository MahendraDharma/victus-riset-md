unfix   gamma_out
unfix   rigid_eq
unfix   nve_eq_surf
unfix   lang_eq_surf
unfix   hold_drop

# ================================================================
# SNAPSHOT — ukur d0 dan gap sebelum impact
# ================================================================
variable  d0      equal  bound(liquid,xmax)-bound(liquid,xmin)
variable  gap_val equal  bound(liquid,zmin)-bound(surface,zmax)

print "=== PRE-IMPACT CHECK ==="
=== PRE-IMPACT CHECK ===
print "d0  (diameter droplet) = ${d0} Angstrom"
d0  (diameter droplet) = 77.3344103481111 Angstrom
print "gap (droplet-surface)  = ${gap_val} Angstrom"
gap (droplet-surface)  = -3.36760422613445 Angstrom
print "========================"
========================

# Jika gap masih kurang aman, AUTO-KOREKSI dgn menaikkan droplet
# (bukan langsung quit), lalu cek ulang.
if "${gap_val} < ${gap_min}" then    "print 'PERINGATAN: gap kurang aman (${gap_val} A). Auto-recenter droplet...'"    "variable z_fix equal (${gap_min}+5.0)-${gap_val}"    "displace_atoms liquid move 0.0 0.0 ${z_fix} units box"    "variable gap_val2 equal bound(liquid,zmin)-bound(surface,zmax)"    "print 'Gap setelah koreksi = ${gap_val2} A'"
print 'PERINGATAN: gap kurang aman (${gap_val} A). Auto-recenter droplet...'
PERINGATAN: gap kurang aman (-3.36760422613445 A). Auto-recenter droplet...
variable z_fix equal (${gap_min}+5.0)-${gap_val}
variable z_fix equal (2+5.0)-${gap_val}
variable z_fix equal (2+5.0)--3.36760422613445
displace_atoms liquid move 0.0 0.0 ${z_fix} units box
displace_atoms liquid move 0.0 0.0 10.3676042261344 units box
Displacing atoms ...
variable gap_val2 equal bound(liquid,zmin)-bound(surface,zmax)
print 'Gap setelah koreksi = ${gap_val2} A'
Gap setelah koreksi = 6.99999999999995 A

variable  d0_fix  equal  ${d0}
variable  d0_fix  equal  77.3344103481111
variable  v0_fix  equal  ${v_impact}
variable  v0_fix  equal  0.0108
variable  dt_fix  equal  ${dt_imp}
variable  dt_fix  equal  0.25

# ================================================================
# DIMENSIONLESS NUMBERS (nanodroplet MD)
# ================================================================
variable  v_ms    equal  ${v_impact}*100.0
variable  v_ms    equal  0.0108*100.0
variable  d0_m    equal  ${d0_fix}*1.0e-10
variable  d0_m    equal  77.3344103481111*1.0e-10
variable  We_num  equal  ${rho_liq}*(${v_ms}^2)*${d0_m}/${sigma_lv}
variable  We_num  equal  997*(${v_ms}^2)*${d0_m}/${sigma_lv}
variable  We_num  equal  997*(1.08^2)*${d0_m}/${sigma_lv}
variable  We_num  equal  997*(1.08^2)*7.73344103481111e-09/${sigma_lv}
variable  We_num  equal  997*(1.08^2)*7.73344103481111e-09/0.0719
variable  Re_num  equal  ${rho_liq}*${v_ms}*${d0_m}/${mu_liq}
variable  Re_num  equal  997*${v_ms}*${d0_m}/${mu_liq}
variable  Re_num  equal  997*1.08*${d0_m}/${mu_liq}
variable  Re_num  equal  997*1.08*7.73344103481111e-09/${mu_liq}
variable  Re_num  equal  997*1.08*7.73344103481111e-09/0.00085
variable  Oh_num  equal  ${mu_liq}/sqrt(${rho_liq}*${sigma_lv}*${d0_m})
variable  Oh_num  equal  0.00085/sqrt(${rho_liq}*${sigma_lv}*${d0_m})
variable  Oh_num  equal  0.00085/sqrt(997*${sigma_lv}*${d0_m})
variable  Oh_num  equal  0.00085/sqrt(997*0.0719*${d0_m})
variable  Oh_num  equal  0.00085/sqrt(997*0.0719*7.73344103481111e-09)

print "=== DIMENSIONLESS NUMBERS (nanodroplet MD) ==="
=== DIMENSIONLESS NUMBERS (nanodroplet MD) ===
print "d0_fix=${d0_fix} A | v=${v_ms} m/s | We=${We_num} | Re=${Re_num} | Oh=${Oh_num}"
d0_fix=77.3344103481111 A | v=1.08 m/s | We=0.000125079621225795 | Re=0.00979654113958025 | Oh=1.1416172229334
print "--- target makroskala Wibowo (We=55.85/Re=4457.8) TIDAK dicocokkan ---"
--- target makroskala Wibowo (We=55.85/Re=4457.8) TIDAK dicocokkan ---
print "============================================="
=============================================

# ================================================================
# PHASE 1 + 2 — Impact lalu Settle hingga tau = 140
# Total ~6.14 juta step (tau=140). Impact aktif sampai tau~10.
# ================================================================
print ">>> PHASE 1+2: Impact -> Settle | target tau=140"
>>> PHASE 1+2: Impact -> Settle | target tau=140

reset_timestep 0
timestep ${dt_imp}
timestep 0.25

variable  v_ms    delete
variable  d0_m    delete
variable  We_num  delete
variable  Re_num  delete
variable  Oh_num  delete
variable  v_ms    equal  ${v_impact}*100.0
variable  v_ms    equal  0.0108*100.0
variable  d0_m    equal  ${d0_fix}*1.0e-10
variable  d0_m    equal  77.3344103481111*1.0e-10
variable  We_num  equal  ${rho_liq}*(${v_ms}^2)*${d0_m}/${sigma_lv}
variable  We_num  equal  997*(${v_ms}^2)*${d0_m}/${sigma_lv}
variable  We_num  equal  997*(1.08^2)*${d0_m}/${sigma_lv}
variable  We_num  equal  997*(1.08^2)*7.73344103481111e-09/${sigma_lv}
variable  We_num  equal  997*(1.08^2)*7.73344103481111e-09/0.0719
variable  Re_num  equal  ${rho_liq}*${v_ms}*${d0_m}/${mu_liq}
variable  Re_num  equal  997*${v_ms}*${d0_m}/${mu_liq}
variable  Re_num  equal  997*1.08*${d0_m}/${mu_liq}
variable  Re_num  equal  997*1.08*7.73344103481111e-09/${mu_liq}
variable  Re_num  equal  997*1.08*7.73344103481111e-09/0.00085
variable  Oh_num  equal  ${mu_liq}/sqrt(${rho_liq}*${sigma_lv}*${d0_m})
variable  Oh_num  equal  0.00085/sqrt(${rho_liq}*${sigma_lv}*${d0_m})
variable  Oh_num  equal  0.00085/sqrt(997*${sigma_lv}*${d0_m})
variable  Oh_num  equal  0.00085/sqrt(997*0.0719*${d0_m})
variable  Oh_num  equal  0.00085/sqrt(997*0.0719*7.73344103481111e-09)

fix     lang_surf    therm_surf  langevin  ${TEMP}  ${TEMP}  100.0  48279
fix     lang_surf    therm_surf  langevin  383  ${TEMP}  100.0  48279
fix     lang_surf    therm_surf  langevin  383  383  100.0  48279
fix     nve_surface  therm_surf  nve

velocity liquid set NULL NULL -${v_impact} sum yes
velocity liquid set NULL NULL -0.0108 sum yes
# Termostat cairan saat impact: langevin damping menengah (500 fs)
# via opsi bawaan fix rigid/small. Tujuan: buang panas tumbukan (cegah
# lonjakan suhu -> ledakan/penguapan) tanpa terlalu meredam impact.
# 500 fs = kompromi: cukup cepat tahan lonjakan termal (~2ps), cukup
# lemah agar dinamika spreading tetap hidup. Target 383K (suhu permukaan
# panas) krn droplet memang setimbang ke suhu substrat (studi Wibowo).
fix rigid_nve liquid rigid/small molecule         langevin ${TEMP} ${TEMP} 100.0 581043
fix rigid_nve liquid rigid/small molecule         langevin 383 ${TEMP} 100.0 581043
fix rigid_nve liquid rigid/small molecule         langevin 383 383 100.0 581043
Fix rigid/small setup ...
  create bodies CPU = 0.000 seconds
  3000 rigid bodies with 9000 atoms
  0.95872676 = max distance from body owner to body atom
fix wall_top liquid wall/reflect zhi EDGE

restart 50000  ../output/restart_0EG_T${TEMP}_run.*
restart 50000  ../output/restart_0EG_T383_run.*

# ---------------------------------------------------------------
# VARIABEL SPREADING & GEOMETRI (dinamis -> pakai v_...)
# ---------------------------------------------------------------
variable  x_span    equal  bound(liquid,xmax)-bound(liquid,xmin)
variable  z_surf    equal  bound(surface,zmax)
variable  apex_abs  equal  bound(liquid,zmax)-v_z_surf
variable  spread    equal  v_x_span/${d0_fix}
variable  spread    equal  v_x_span/77.3344103481111
variable  apex      equal  v_apex_abs/${d0_fix}
variable  apex      equal  v_apex_abs/77.3344103481111
variable  tau       equal  step*${dt_fix}*${v0_fix}/${d0_fix}
variable  tau       equal  step*0.25*${v0_fix}/${d0_fix}
variable  tau       equal  step*0.25*0.0108/${d0_fix}
variable  tau       equal  step*0.25*0.0108/77.3344103481111

# ---------------------------------------------------------------
# VALIDASI #2 — PROFIL DENSITAS untuk ekstraksi theta & r_b
# chunk berdasarkan jarak radial dari sumbu droplet (silinder)
# dan ketinggian z. Hasil di-postprocess utk fitting busur lingkaran
# -> theta (contact angle) dan r_b (base radius).
# ---------------------------------------------------------------
# Pusat droplet pada x,y (dipakai post-processing & monitoring).
variable  xc equal (bound(liquid,xmax)+bound(liquid,xmin))/2.0
variable  yc equal (bound(liquid,ymax)+bound(liquid,ymin))/2.0

# Peta densitas 2D irisan (x,z): bin 2 A x 2 A.
# Memberi profil densitas penuh di bidang x-z yang memotong droplet,
# dari mana kontur tepi (rho = 0.5*rho_bulk) difit busur lingkaran
# untuk mendapatkan contact angle (theta) dan base radius (r_b).
# Sintaks: chunk/atom bin/2d dim1 origin1 delta1 dim2 origin2 delta2 [opsi]
compute   binRZ liquid chunk/atom bin/2d x lower 2.0 z lower 2.0 units box
fix       dprof liquid ave/chunk 1000 100 200000 binRZ density/mass           file ../output/densprofile_0EG_T${TEMP}.dat
fix       dprof liquid ave/chunk 1000 100 200000 binRZ density/mass           file ../output/densprofile_0EG_T383.dat

# Output spreading data (mulai rapat utk fase impact)
dump    imp_dump  all  custom  500          ../output/traj_run_0EG_T${TEMP}.lammpstrj          id type x y z vx vy vz
dump    imp_dump  all  custom  500          ../output/traj_run_0EG_T383.lammpstrj          id type x y z vx vy vz
dump_modify  imp_dump  sort id  format float %12.6f

fix     spread_out  all  print  500          "${tau}  ${spread}  ${apex}  ${We_num}  ${Re_num}  ${Oh_num}"          file   ../output/spreading_0EG_T${TEMP}.dat          title  "tau    d/d0    h/d0    We    Re    Oh"
fix     spread_out  all  print  500          "${tau}  ${spread}  ${apex}  ${We_num}  ${Re_num}  ${Oh_num}"          file   ../output/spreading_0EG_T383.dat          title  "tau    d/d0    h/d0    We    Re    Oh"

thermo       1000
thermo_style custom step c_T_surf c_T_liq pe ke etotal press              v_spread v_apex v_tau
thermo_modify flush yes

# ---- PHASE 1: IMPACT DINAMIS (spreading) ----
# Durasi ~640 ps (~8x waktu kapiler t_c=80ps) agar spreading maksimum
# dan awal recoil terekam. tau di sini melonjak besar (krn v tinggi) dan
# TIDAK dipakai sbg kontrol — kontrol = jumlah step. tau tetap ditulis
# ke file sbg keluaran karakterisasi.
# Data spreading (d/d0 vs waktu) untuk dibandingkan dgn Wibowo via
# rasio tak berdimensi (beta_max), BUKAN via We yang dicocokkan.
print ">>> PHASE 1: Impact dinamis / spreading (~640 ps)"
>>> PHASE 1: Impact dinamis / spreading (~640 ps)
