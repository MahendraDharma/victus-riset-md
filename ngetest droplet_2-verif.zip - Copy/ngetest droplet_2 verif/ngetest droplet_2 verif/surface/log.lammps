# ---------------------------------------------------------------
# TIMESTEP
# ---------------------------------------------------------------
timestep    1.0

# ---------------------------------------------------------------
# PHASE 0 — Pre-equilibrasi ringan 100 ps
# ---------------------------------------------------------------
print ">>> PHASE 0: Pre-equilibrasi 100 ps | T=${TEMP}K"
>>> PHASE 0: Pre-equilibrasi 100 ps | T=383K

velocity therm_surf  create  ${TEMP}  87287  dist gaussian
velocity therm_surf  create  383  87287  dist gaussian
fix      lang_surf   therm_surf  langevin  ${TEMP}  ${TEMP}  100.0  48279
fix      lang_surf   therm_surf  langevin  383  ${TEMP}  100.0  48279
fix      lang_surf   therm_surf  langevin  383  383  100.0  48279
fix      nve_surf    therm_surf  nve

thermo       1000
thermo_style custom  step  c_T_surf  pe  ke  etotal  press
thermo_modify flush yes

fix  preequil_monitor  all  print  1000       "PRE $(step)  $(c_E_surf_total)  $(c_T_surf)"       file   ../output/equil_monitor_T${TEMP}.dat       title  "# step   E_surf(kcal/mol)   T_surf(K)"
fix  preequil_monitor  all  print  1000       "PRE $(step)  $(c_E_surf_total)  $(c_T_surf)"       file   ../output/equil_monitor_T383.dat       title  "# step   E_surf(kcal/mol)   T_surf(K)"

run     100000
