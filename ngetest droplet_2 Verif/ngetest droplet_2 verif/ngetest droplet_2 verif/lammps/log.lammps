# Bersihkan fix equilibrasi
undump  eq_dump
unfix   rigid_eq
unfix   nve_eq_surf
unfix   lang_eq_surf

# ========================================================================
# SNAPSHOT — ukur d0 dan gap sebelum impact
# ================================================================
variable  d0      equal  bound(liquid,xmax)-bound(liquid,xmin)
variable  gap_val equal  bound(liquid,zmin)-bound(surface,zmax)

print "=== PRE-IMPACT CHECK ==="
=== PRE-IMPACT CHECK ===
print "d0  (diameter droplet) = ${d0} Angstrom"
d0  (diameter droplet) = 75.5472750219224 Angstrom
print "gap (droplet-surface)  = ${gap_val} Angstrom"
gap (droplet-surface)  = 7.7003665689265 Angstrom
print "========================"
========================

if "${gap_val} < ${gap_min}" then    "print 'ERROR: gap pre-impact (${gap_val} A) lebih kecil dari gap_min (${gap_min} A). Geser droplet ke atas atau perbaiki struktur awal sebelum phase impact.'"    "quit 1"

# ================================================================
# PHASE 2 — Impact 200 ps
# ================================================================
print ">>> PHASE 2: Impact | 0EG T=${TEMP}K"
>>> PHASE 2: Impact | 0EG T=383K

# Reset step agar waktu impact mulai dari nol
reset_timestep 0

# 1. TURUNKAN TIMESTEP (Sangat krusial untuk mencegah lost atoms)
timestep ${dt_imp}
timestep 0.25

# 2. AKTIFKAN THERMOSTAT HANYA PADA THERM_SURF
fix     lang_surf    therm_surf  langevin  ${TEMP}  ${TEMP}  100.0  48279
fix     lang_surf    therm_surf  langevin  383  ${TEMP}  100.0  48279
fix     lang_surf    therm_surf  langevin  383  383  100.0  48279
fix     nve_surface  therm_surf  nve

# 3. SET KECEPATAN IMPACT
# Gunakan NULL agar suhu X dan Y tidak hilang, dan sum yes agar tidak reset suhu Z
velocity liquid set NULL NULL -${v_impact} sum yes
velocity liquid set NULL NULL -0.00684 sum yes

# 4. JAGA GEOMETRI AIR
fix     rigid_nve  liquid  rigid/small  molecule
Fix rigid/small setup ...
  create bodies CPU = 0.000 seconds
  3000 rigid bodies with 9000 atoms
  0.95872676 = max distance from body owner to body atom

# Simpan restart berkala agar step gagal bisa dilanjutkan dari dekat titik crash
restart 5000  ../output/restart_0EG_T${TEMP}_impact.*
restart 5000  ../output/restart_0EG_T383_impact.*

# ---------------------------------------------------------------
# VARIABEL DIMENSIONLESS (Wibowo et al. Eq. 1)
#
# tau    = t * v / d0 = step * dt * v / d0
#        = step * dt_imp(fs) * v_impact(A/fs) / d0(A)
# spread = d/d0  = x_span / d0
# apex   = h/d0  = (zmax_liquid - zmax_surface) / d0
# ---------------------------------------------------------------
variable  x_span    equal  bound(liquid,xmax)-bound(liquid,xmin)
variable  z_surface equal  bound(surface,zmax)
variable  apex_abs  equal  bound(liquid,zmax)-v_z_surface
variable  spread    equal  v_x_span/v_d0
variable  apex      equal  v_apex_abs/v_d0
variable  tau       equal  step*v_dt_imp*v_v_impact/v_d0

# Output trajectory impact
dump    imp_dump  all  custom  100          ../output/traj_impact_0EG_T${TEMP}.lammpstrj          id type x y z vx vy vz
dump    imp_dump  all  custom  100          ../output/traj_impact_0EG_T383.lammpstrj          id type x y z vx vy vz
dump_modify  imp_dump  sort id  format float %12.6f

# Output spreading ratio dan apex height
fix     spread_out  all  print  100          "${tau}  ${spread}  ${apex}"          file   ../output/spreading_0EG_T${TEMP}.dat          title  "tau    d/d0    h/d0"
fix     spread_out  all  print  100          "${tau}  ${spread}  ${apex}"          file   ../output/spreading_0EG_T383.dat          title  "tau    d/d0    h/d0"

thermo       100
thermo_style custom  step  c_T_surf  c_T_liq  pe  ke  etotal  press  v_spread  v_apex
thermo_modify flush yes

run     100000
