# ================================================================
# Nanodroplet Impact Simulation
# System   : Air Murni (0% EG) pada SUS304
# Suhu     : T_surface = 383 K (110 C)
# Referensi: Wibowo et al., Int. J. Thermal Sci. 159 (2021) 106594
# Water    : SPC/E model
# Surface  : EAM FeNiCr (Bonny 2013)
#
# Jalankan:
#  mpirun -np 32 lmp_mpi -in in.0EG_T383_110C.lammps -var TEMP 383
# ================================================================

# ---------------------------------------------------------------
# SETUP DASAR
# ---------------------------------------------------------------
units           real
atom_style      full
boundary        p p f
processors      8 4 1

# Pair style: gabungan LJ/Coulomb untuk air + EAM untuk logam
pair_style      hybrid/overlay  lj/cut/coul/long 10.0  eam/alloy
bond_style      harmonic
angle_style     harmonic
kspace_style    pppm  1.0e-5
kspace_modify   slab  3.0

# ---------------------------------------------------------------
# BACA DATA STRUKTUR
# ---------------------------------------------------------------
read_data       ../structures/system_0EG.data


# ---------------------------------------------------------------
# GRUP ATOM
# ---------------------------------------------------------------
group   surface  type 1 2 3
group   liquid   type 4 5

# Naikkan droplet agar gap tetap aman setelah fase equilibrasi
variable z_lift equal 10.0
displace_atoms liquid move 0.0 0.0 ${z_lift} units box

# --- TAMBAHAN UNTUK ANCHORING PERMUKAAN ---
# Mengambil koordinat Z paling bawah, dan membuat area setebal 5 Angstrom
variable z_anchor equal bound(surface,zmin)+5.0
region   anchor_reg block INF INF INF INF INF ${z_anchor}

# Membagi surface menjadi 2 bagian: anchor (diam) dan therm (bergerak/termal)
group    anchor_surf region anchor_reg
group    therm_surf subtract surface anchor_surf

# ---------------------------------------------------------------
# NEIGHBOR LIST
# ---------------------------------------------------------------
neighbor        2.0  bin
neigh_modify    every 1  delay 0  check yes
comm_modify     cutoff 15.0

# ---------------------------------------------------------------
# PAIR COEFFICIENTS
# ---------------------------------------------------------------

# EAM untuk permukaan (Fe, Cr, Ni) — NULL untuk tipe air
pair_coeff  * *  eam/alloy  ../potentials/FeNiCr_Bonny_2013_ptDef.eam.alloy  Fe Cr Ni NULL NULL

# LJ antar atom permukaan = 0 (interaksi logam ditangani EAM)
pair_coeff  1  1  lj/cut/coul/long  0.0000  1.000
pair_coeff  1  2  lj/cut/coul/long  0.0000  1.000
pair_coeff  1  3  lj/cut/coul/long  0.0000  1.000
pair_coeff  2  2  lj/cut/coul/long  0.0000  1.000
pair_coeff  2  3  lj/cut/coul/long  0.0000  1.000
pair_coeff  3  3  lj/cut/coul/long  0.0000  1.000

# SPC/E water: O-O (epsilon=0.1554 kcal/mol, sigma=3.166 A)
pair_coeff  4  4  lj/cut/coul/long  0.1554  3.166
# SPC/E water: O-H dan H-H = nol LJ
pair_coeff  4  5  lj/cut/coul/long  0.0000  1.000
pair_coeff  5  5  lj/cut/coul/long  0.0000  1.000

# Interaksi permukaan-air (Werder et al.)
pair_coeff  1  4  lj/cut/coul/long  0.0798  2.744
pair_coeff  1  5  lj/cut/coul/long  0.0000  1.000
pair_coeff  2  4  lj/cut/coul/long  0.0798  2.744
pair_coeff  2  5  lj/cut/coul/long  0.0000  1.000
pair_coeff  3  4  lj/cut/coul/long  0.0798  2.744
pair_coeff  3  5  lj/cut/coul/long  0.0000  1.000

# ---------------------------------------------------------------
# BOND & ANGLE — SPC/E water
# O-H bond : k=1000 kcal/mol/A^2, r0=1.0 A
# H-O-H    : k=100  kcal/mol/rad^2, theta0=109.47 deg
# ---------------------------------------------------------------
bond_coeff   1   1000.0   1.000
angle_coeff  1    100.0   109.47

# ---------------------------------------------------------------
# PARAMETER WAKTU & IMPACT
# ---------------------------------------------------------------
variable    dt_eq      equal 2.0
variable    dt_imp     equal 0.25
variable    v_impact   equal 0.00684
variable    gap_min    equal 2.0

timestep    ${dt_eq}

# ---------------------------------------------------------------
# COMPUTE SUHU
# ---------------------------------------------------------------
compute     T_surf   therm_surf  temp
compute     T_liq    liquid   temp/com

# ================================================================
# PHASE 1 — Equilibrasi 50 ps (25000 steps x 2 fs)
# Tujuan: stabilkan droplet pada 300 K sebelum impact
# ================================================================
print ">>> PHASE 1: Equilibrasi 50 ps | 0EG T=${TEMP}K"

# Bekukan HANYA bagian bawah permukaan (jangkar) secara permanen
fix     freeze_anchor  anchor_surf  setforce  0.0  0.0  0.0
velocity anchor_surf   set          0.0  0.0  0.0

# Thermalize hanya bagian surface yang tidak di-anchor
velocity therm_surf    create       ${TEMP}  87287  dist gaussian
fix      lang_eq_surf  therm_surf   langevin ${TEMP} ${TEMP} 100.0 48279
fix      nve_eq_surf   therm_surf   nve

# Inisialisasi kecepatan droplet pada 300 K
velocity liquid      create   300.0  48731  rot yes  dist gaussian

# NVT rigid untuk menjaga geometri molekul SPC/E
fix     rigid_eq  liquid  rigid/small  molecule  &
        langevin  300.0  300.0  100.0  48731

# Output trajectory equilibrasi
dump    eq_dump  all  custom  500  &
        ../output/traj_eq_0EG_T${TEMP}.lammpstrj  &
        id type x y z vx vy vz
dump_modify  eq_dump  sort id  format float %12.6f

thermo       500
thermo_style custom  step  c_T_surf  c_T_liq  pe  ke  etotal  press

run     25000

# Bersihkan fix equilibrasi
undump  eq_dump
unfix   rigid_eq
unfix   nve_eq_surf
unfix   lang_eq_surf

# ================================================================
# SNAPSHOT — ukur d0 dan gap sebelum impact
# ================================================================
variable  d0      equal  bound(liquid,xmax)-bound(liquid,xmin)
variable  gap_val equal  bound(liquid,zmin)-bound(surface,zmax)

print "=== PRE-IMPACT CHECK ==="
print "d0  (diameter droplet) = ${d0} Angstrom"
print "gap (droplet-surface)  = ${gap_val} Angstrom"
print "========================"

if "${gap_val} < ${gap_min}" then &
   "print 'ERROR: gap pre-impact (${gap_val} A) lebih kecil dari gap_min (${gap_min} A). Geser droplet ke atas atau perbaiki struktur awal sebelum phase impact.'" &
   "quit 1"
   

# ================================================================
# setelah d0 terukur, sebelum Phase 2 ▼▼▼
# ================================================================
variable  d0_fix  equal  ${d0}        # freeze nilai d0 saat pre-impact
variable  v0_fix  equal  ${v_impact}  # kecepatan impact (A/fs)
variable  dt_fix  equal  ${dt_imp}    # timestep phase impact (fs)

print "=== NILAI YANG DIGUNAKAN UNTUK DIMENSIONLESS ==="
print "d0_fix  = ${d0_fix} Angstrom"
print "v0_fix  = ${v0_fix} A/fs"
print "dt_fix  = ${dt_fix} fs"
print "================================================"

# ================================================================
# PHASE 2 — Impact 200 ps
# ================================================================
print ">>> PHASE 2: Impact | 0EG T=${TEMP}K"

# Reset step agar waktu impact mulai dari nol
reset_timestep 0

# 1. TURUNKAN TIMESTEP (Sangat krusial untuk mencegah lost atoms)
timestep ${dt_imp}

# 2. AKTIFKAN THERMOSTAT HANYA PADA THERM_SURF
fix     lang_surf    therm_surf  langevin  ${TEMP}  ${TEMP}  100.0  48279
fix     nve_surface  therm_surf  nve

# 3. SET KECEPATAN IMPACT
# Gunakan NULL agar suhu X dan Y tidak hilang, dan sum yes agar tidak reset suhu Z
velocity liquid set NULL NULL -${v_impact} sum yes

# 4. JAGA GEOMETRI AIR
fix     rigid_nve  liquid  rigid/small  molecule

# Simpan restart berkala agar step gagal bisa dilanjutkan dari dekat titik crash
restart 5000  ../output/restart_0EG_T${TEMP}_impact.*

# ---------------------------------------------------------------
# VARIABEL DIMENSIONLESS (Wibowo et al. Eq. 1)
#
# tau    = t * v / d0 = step * dt * v / d0
#        = step * dt_imp(fs) * v_impact(A/fs) / d0(A)
# spread = d/d0  = x_span / d0
# apex   = h/d0  = (zmax_liquid - zmax_surface) / d0
# ---------------------------------------------------------------
variable  x_span    equal  bound(liquid,xmax)-bound(liquid,xmin)
variable  z_surf    equal  bound(surface,zmax)
variable  apex_abs  equal  bound(liquid,zmax)-${z_surf}
variable  spread    equal  v_x_span/${d0_fix}
variable  apex      equal  v_apex_abs/${d0_fix}
variable  tau       equal  step*${dt_fix}*${v0_fix}/${d0_fix}

# Output trajectory impact
dump    imp_dump  all  custom  100  &
        ../output/traj_impact_0EG_T${TEMP}.lammpstrj  &
        id type x y z vx vy vz
dump_modify  imp_dump  sort id  format float %12.6f

# Output spreading ratio dan apex height
fix     spread_out  all  print  100  &
        "${tau}  ${spread}  ${apex}"  &
        file   ../output/spreading_0EG_T${TEMP}.dat  &
        title  "tau    d/d0    h/d0"

thermo       100
thermo_style custom  step  c_T_surf  c_T_liq  pe  ke  etotal  press  v_spread  v_apex
thermo_modify flush yes

run     100000

# ================================================================
# CLEANUP — urutan unfix harus kebalikan dari fix
# ================================================================
undump  imp_dump
unfix   spread_out
unfix   rigid_nve
unfix   nve_surface
unfix   lang_surf
unfix   freeze_anchor
restart 0

print "=== SELESAI: 0EG T=${TEMP}K ==="
