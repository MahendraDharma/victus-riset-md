LAMMPS (22 Jul 2025 - Update 1)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
# ================================================================
# Nanodroplet Impact + Equilibrium (Sessile) Simulation
# System   : Air Murni (0% EG) pada SUS304
# Suhu     : T_surface = 383 K (110 C)
# Referensi: Wibowo et al., Int. J. Thermal Sci. 159 (2021) 106594
# Water    : SPC/E model | Surface: EAM FeNiCr (Bonny 2013)
#
# TUJUAN VALIDASI (rekomendasi pembimbing):
#   Membandingkan droplet nano (MD) vs makro (eksperimen) melalui
#   modified Young's equation:
#       gamma_SV = gamma_SL + gamma_LV*cos(theta) + tau_line/r_b
#   Strategi: ukur gamma_LV, contact angle (theta), dan r_b di MD,
#   lalu plot cos(theta) vs 1/r_b. Intercept (1/r_b -> 0) memberi
#   theta makroskopik untuk dibandingkan dengan eksperimen.
#
# STRUKTUR FASE:
#   PHASE 0  : Equilibrasi sistem (50 ps)
#   PHASE 0b : Rekam tensor tekanan (gamma_LV indikatif - lihat catatan)
#   PHASE 1  : Impact dinamis / spreading (~640 ps, We~5, v=216 m/s)
#              -> data d/d0 vs waktu untuk studi spreading
#   PHASE 2  : Relaksasi / wettability (~800 ps, sessile equilibrium)
#              -> profil densitas untuk ekstraksi theta & r_b  <-- VALIDASI
#
# CATATAN We: We~5 adalah nilai NANO. We Wibowo (55.85) makroskala #   tidak realistis di d~7.7nm (butuh v supersonik). We hanya dilaporkan
#   sbg karakterisasi; validasi nano<->makro lewat contact angle (theta).
#
# CATATAN gamma_LV: tensor tekanan pd DROPLET memberi nilai berfluktuasi
#   (bukan slab planar). Untuk gamma_LV akurat, jalankan simulasi slab
#   air terpisah. Di sini gunakan nilai referensi SPC/E literatur.
#
# VALIDASI: ulangi simulasi utk beberapa UKURAN droplet (variasi r_b),
#   plot cos(theta) vs 1/r_b, intercept 1/r_b->0 = theta makro.
#
# Jalankan:
#   mpirun -np 32 lmp_mpi -in in.0EG_T383_110C_FIXED.lammps -var TEMP 383
# ================================================================

# ---------------------------------------------------------------
# SETUP DASAR
# ---------------------------------------------------------------
units           real
atom_style      full
boundary        p p f
processors      8 4 1

pair_style      hybrid/overlay  lj/cut/coul/long 10.0  eam/alloy
bond_style      harmonic
angle_style     harmonic
kspace_style    pppm  1.0e-5
kspace_modify   slab  3.0

read_data       ../structures/system_0EG.data
Reading data file ...
  orthogonal box = (0 0 0) to (107.7 107.7 197.192)
  8 by 4 by 1 MPI processor grid
  reading atoms ...
  37800 atoms
  scanning bonds ...
  2 = max bonds/atom
  scanning angles ...
  1 = max angles/atom
  orthogonal box = (0 0 0) to (107.7 107.7 197.192)
  8 by 4 by 1 MPI processor grid
  reading bonds ...
  6000 bonds
  reading angles ...
  3000 angles
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     1 = max # of 1-3 neighbors
     1 = max # of 1-4 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.003 seconds
  read_data CPU = 1.864 seconds

# ---------------------------------------------------------------
# GRUP ATOM
# ---------------------------------------------------------------
group   surface  type 1 2 3
28800 atoms in group surface
group   liquid   type 4 5
9000 atoms in group liquid

# ---------------------------------------------------------------
# POSISIKAN DROPLET DI ATAS PERMUKAAN DENGAN GAP TERJAMIN
# ---------------------------------------------------------------
# Masalah pada run sebelumnya: gap negatif (-7 A) krn droplet
# tertarik turun & menempel permukaan selama equilibrasi (~70 ps).
# Solusi: tempatkan dasar droplet pada jarak ABSOLUT 'gap_init'
# di atas permukaan, lalu TAHAN posisi-z droplet selama equilibrasi
# (fix spring/self) supaya tidak melorot sebelum impact.
variable  gap_init  equal  20.0    # gap awal generous (A)
variable  surf_top  equal  bound(surface,zmax)
variable  liq_bot   equal  bound(liquid,zmin)
# geser droplet supaya: liq_bot_baru = surf_top + gap_init
variable  z_shift   equal  (v_surf_top+v_gap_init)-v_liq_bot
displace_atoms liquid move 0.0 0.0 ${z_shift} units box
displace_atoms liquid move 0.0 0.0 3.205 units box
Displacing atoms ...

print "=== POSISI AWAL DROPLET ==="
=== POSISI AWAL DROPLET ===
print "surface_zmax = ${surf_top} A | z_shift diterapkan = ${z_shift} A"
surface_zmax = 26.925 A | z_shift diterapkan = 0 A
print "gap awal target = ${gap_init} A"
gap awal target = 20 A
print "==========================="
===========================

variable z_anchor equal bound(surface,zmin)+5.0
region   anchor_reg block INF INF INF INF INF ${z_anchor}
region   anchor_reg block INF INF INF INF INF 5
group    anchor_surf region anchor_reg
5400 atoms in group anchor_surf
group    therm_surf  subtract surface anchor_surf
23400 atoms in group therm_surf

# ---------------------------------------------------------------
# NEIGHBOR LIST
# ---------------------------------------------------------------
neighbor        2.0  bin
neigh_modify    every 1  delay 0  check yes
comm_modify     cutoff 15.0

# ---------------------------------------------------------------
# PAIR COEFFICIENTS
# ---------------------------------------------------------------
pair_coeff  * *  eam/alloy  ../potentials/FeNiCr_Bonny_2013_ptDef.eam.alloy  Fe Cr Ni NULL NULL
pair_coeff  1  1  lj/cut/coul/long  0.0000  1.000
pair_coeff  1  2  lj/cut/coul/long  0.0000  1.000
pair_coeff  1  3  lj/cut/coul/long  0.0000  1.000
pair_coeff  2  2  lj/cut/coul/long  0.0000  1.000
pair_coeff  2  3  lj/cut/coul/long  0.0000  1.000
pair_coeff  3  3  lj/cut/coul/long  0.0000  1.000
pair_coeff  4  4  lj/cut/coul/long  0.1554  3.166
pair_coeff  4  5  lj/cut/coul/long  0.0000  1.000
pair_coeff  5  5  lj/cut/coul/long  0.0000  1.000
pair_coeff  1  4  lj/cut/coul/long  0.0798  2.744
pair_coeff  1  5  lj/cut/coul/long  0.0000  1.000
pair_coeff  2  4  lj/cut/coul/long  0.0798  2.744
pair_coeff  2  5  lj/cut/coul/long  0.0000  1.000
pair_coeff  3  4  lj/cut/coul/long  0.0798  2.744
pair_coeff  3  5  lj/cut/coul/long  0.0000  1.000

bond_coeff   1   1000.0   1.000
angle_coeff  1    100.0   109.47

# ---------------------------------------------------------------
# PROPERTIES FLUIDA
# ---------------------------------------------------------------
variable  rho_liq   equal  997.0       # kg/m3
variable  sigma_lv  equal  0.0719      # N/m  (nilai REFERENSI; akan diukur di PHASE 0b)
variable  mu_liq    equal  0.00085     # Pa.s

# ---------------------------------------------------------------
# PARAMETER WAKTU & IMPACT
# ---------------------------------------------------------------
variable    dt_eq      equal 2.0
variable    dt_imp     equal 0.25
variable    v_impact equal 0.01080   # 108 m/s
variable    gap_min    equal 2.0

timestep    ${dt_eq}
timestep    2

compute     T_surf   therm_surf  temp
compute     T_liq    liquid      temp/com

# ================================================================
# PHASE 0 — Equilibrasi 50 ps
# ================================================================
print ">>> PHASE 0: Equilibrasi 50 ps | 0EG T=${TEMP}K"
>>> PHASE 0: Equilibrasi 50 ps | 0EG T=383K

fix     freeze_anchor  anchor_surf  setforce  0.0  0.0  0.0
velocity anchor_surf   set          0.0  0.0  0.0

velocity therm_surf    create       ${TEMP}  87287  dist gaussian
velocity therm_surf    create       383  87287  dist gaussian
fix      lang_eq_surf  therm_surf   langevin ${TEMP} ${TEMP} 100.0 48279
fix      lang_eq_surf  therm_surf   langevin 383 ${TEMP} 100.0 48279
fix      lang_eq_surf  therm_surf   langevin 383 383 100.0 48279
fix      nve_eq_surf   therm_surf   nve

velocity liquid      create   300.0  48731  rot yes  dist gaussian
fix     rigid_eq  liquid  rigid/small  molecule          langevin  300.0  300.0  100.0  48731
Fix rigid/small setup ...
  create bodies CPU = 0.001 seconds
  3000 rigid bodies with 9000 atoms
  0.95872676 = max distance from body owner to body atom

# TAHAN posisi pusat massa droplet pada koordinatnya saat ini
# (mencegah droplet melorot & menempel permukaan selama equilibrasi).
# tether lemah di x,y; kuat di z. Dilepas sebelum impact.
fix     hold_drop  liquid  spring  tether  5.0  NULL  NULL          $(0.5*(bound(liquid,zmax)+bound(liquid,zmin)))  0.0
fix     hold_drop  liquid  spring  tether  5.0  NULL  NULL          86.161000000000001364  0.0

dump    eq_dump  all  custom  500          ../output/traj_eq_0EG_T${TEMP}.lammpstrj          id type x y z vx vy vz
dump    eq_dump  all  custom  500          ../output/traj_eq_0EG_T383.lammpstrj          id type x y z vx vy vz
dump_modify  eq_dump  sort id  format float %12.6f

thermo       500
thermo_style custom  step  c_T_surf  c_T_liq  pe  ke  etotal  press
run     25000
